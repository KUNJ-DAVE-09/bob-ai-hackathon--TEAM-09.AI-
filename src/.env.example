# Supply Chain Dashboard — Environment Variables Template
# Copy this file to .env and fill in real values for production deployment
# The demo runs entirely without these variables (simulated data mode)

# ─── IBM Watson / Bob Integration ───────────────────────────────────────────
IBM_BOB_API_KEY=your_ibm_bob_api_key_here
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com
IBM_WATSONX_PROJECT_ID=your_project_id_here
IBM_WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# ─── TMS / ERP Integration ──────────────────────────────────────────────────
TMS_API_BASE_URL=https://your-tms.example.com/api/v1
TMS_API_KEY=your_tms_api_key_here
ERP_DATABASE_URL=postgresql://user:password@host:5432/erp_db

# ─── IoT / Cold-Chain Platform ──────────────────────────────────────────────
IOT_PLATFORM_URL=https://your-iot-platform.example.com
IOT_API_KEY=your_iot_api_key_here
IOT_STREAM_INTERVAL_MS=30000

# ─── Weather / Disruption Data Feeds ────────────────────────────────────────
OPENWEATHER_API_KEY=your_openweather_api_key_here
PORT_AUTHORITY_FEED_URL=https://your-port-feed.example.com/disruptions
NEWS_API_KEY=your_news_api_key_here

# ─── Application Config ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
SESSION_SECRET=replace_with_long_random_string_here
